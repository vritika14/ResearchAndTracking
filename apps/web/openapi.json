{
  "openapi": "3.0.0",
  "info": { "title": "Research Tracker API", "version": "1.0" },
  "paths": {
    "/api/v1/me": { "get": { "operationId": "MeController_getMe", "responses": { "200": { "description": "Authenticated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } } } } },
    "/api/v1/workspaces": { "post": { "operationId": "WorkspacesController_create", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWorkspace" } } } }, "responses": { "201": { "description": "Workspace created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } } } } },
    "/api/v1/workspaces/current": { "get": { "operationId": "WorkspacesController_getCurrent", "responses": { "200": { "description": "Current workspace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } }, "404": { "description": "User has no workspace" } } } },
    "/api/v1/invitations/{token}": { "get": { "operationId": "InvitationsController_preview", "parameters": [{ "$ref": "#/components/parameters/InvitationToken" }], "responses": { "200": { "description": "Invitation preview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationPreview" } } } }, "404": { "description": "Invitation not found" }, "410": { "description": "Invitation unavailable" } } } },
    "/api/v1/invitations/{token}/accept": { "post": { "operationId": "InvitationsController_accept", "parameters": [{ "$ref": "#/components/parameters/InvitationToken" }], "responses": { "201": { "description": "Invitation accepted", "content": { "application/json": { "schema": { "type": "object", "required": ["membership"], "properties": { "membership": { "$ref": "#/components/schemas/Membership" } } } } } }, "403": { "description": "Authenticated email does not match" }, "404": { "description": "Invitation not found" }, "410": { "description": "Invitation unavailable" } } } },
    "/api/v1/tenant/{tenantId}/members": { "get": { "operationId": "MembershipsController_listMembers", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "200": { "description": "Active members", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Membership" } } } } } } } },
    "/api/v1/tenant/{tenantId}/invitations": { "post": { "operationId": "MembershipsController_inviteMember", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateInvitation" } } } }, "responses": { "201": { "description": "Invitation created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedInvitation" } } } } } } }
  },
  "components": {
    "parameters": {
      "InvitationToken": { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } },
      "TenantId": { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "schemas": {
      "Me": { "type": "object", "required": ["id", "email", "displayName", "status"], "properties": { "id": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" }, "displayName": { "type": "string" }, "status": { "type": "string" } } },
      "CreateWorkspace": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 100 } } },
      "Workspace": { "type": "object", "required": ["id", "name", "slug", "status", "ownerUserId", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "slug": { "type": "string" }, "status": { "type": "string" }, "ownerUserId": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "InvitationPreview": { "type": "object", "required": ["workspaceName", "invitedEmail", "role", "expiresAt"], "properties": { "workspaceName": { "type": "string" }, "invitedEmail": { "type": "string" }, "role": { "type": "string", "enum": ["limited_member"] }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "Membership": { "type": "object", "required": ["id", "tenantId", "userId", "role", "status", "invitedAt", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "tenantId": { "type": "string", "format": "uuid" }, "userId": { "type": "string", "format": "uuid" }, "role": { "type": "string", "enum": ["owner", "limited_member"] }, "status": { "type": "string", "enum": ["active", "revoked"] }, "invitedAt": { "type": "string", "format": "date-time" }, "joinedAt": { "type": "string", "format": "date-time", "nullable": true }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "CreateInvitation": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } },
      "Invitation": { "type": "object", "required": ["id", "tenantId", "email", "role", "invitedBy", "status", "expiresAt", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "tenantId": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" }, "role": { "type": "string", "enum": ["limited_member"] }, "invitedBy": { "type": "string", "format": "uuid" }, "status": { "type": "string", "enum": ["pending"] }, "expiresAt": { "type": "string", "format": "date-time" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "CreatedInvitation": { "type": "object", "required": ["invitation", "acceptanceToken"], "properties": { "invitation": { "$ref": "#/components/schemas/Invitation" }, "acceptanceToken": { "type": "string" } } }
    },
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } }
  },
  "security": [{ "bearer": [] }]
}
