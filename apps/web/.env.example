# AWS Cognito (OIDC) — populate from `tofu output -json` in infrastructure/opentofu
# after running `tofu apply` there. See infrastructure/opentofu/README.md.
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user_pool_id>
VITE_COGNITO_CLIENT_ID=<app_client_id>
VITE_COGNITO_DOMAIN=<domain-prefix>-dev.auth.<region>.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPE=openid email profile
VITE_API_URL=http://localhost:3000
