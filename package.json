{
  "name": "@research-tracker/root",
  "version": "1.0.0",
  "description": "Research Pipeline & Tracking Web Application ",
  "keywords": [],
  "author": "Vritika Tuteja",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @research-tracker/api start:dev\" \"pnpm --filter @research-tracker/web dev\"",
    "build": "pnpm -r --filter=./apps/* build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
