# Copy to terraform.tfvars and fill in your own values before running
# `tofu apply`. terraform.tfvars is gitignored — do not commit real values.

aws_region   = "us-east-1"
environment  = "dev"

# Must be globally unique across ALL AWS accounts. Pick something specific
# to you/this project — e.g. "research-tracker-yourname".
cognito_domain_prefix = "research-tracker-CHANGE-ME"

# Defaults already match the local dev server (apps/web runs on :5173).
# Add production URLs here once there's a deployed frontend.
callback_urls = ["http://localhost:5173/auth/callback"]
logout_urls   = ["http://localhost:5173/"]
